{
  "name": "@mirrordraw/plugin-sdk",
  "version": "0.1.0",
  "description": "Type definitions, test helpers and packaging CLI for MirrorDraw desktop plugins",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./testing": {
      "types": "./lib/testing.d.ts",
      "default": "./lib/testing.js"
    }
  },
  "bin": {
    "mirrordraw-plugin": "./bin/mirrordraw-plugin.mjs"
  },
  "files": [
    "lib",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["mirrordraw", "plugin", "sdk"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luo84778255-blip/mirrordraw-devkit.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/luo84778255-blip/mirrordraw-devkit#readme",
  "bugs": "https://github.com/luo84778255-blip/mirrordraw-devkit/issues"
}
