{
  "name": "{{slug}}",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/",
    "validate": "mirrordraw-plugin validate .",
    "pack": "npm run build && mirrordraw-plugin pack . -o {{slug}}.mdplugin"
  },
  "dependencies": {
    "@mirrordraw/plugin-sdk": "^0.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  }
}
