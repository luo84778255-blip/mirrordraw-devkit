{
  "manifestVersion": 1,
  "id": "{{id}}",
  "name": "{{name}}",
  "version": "1.0.0",
  "minAppVersion": "1.80.0",
  "author": "Your Name",
  "description": "{{name}}",
  "runner": "dist/runner.js",
  "network": {
    "allow": []
  },
  "nodes": [
    {
      "type": "main",
      "title": "{{name}}",
      "category": "文本排版",
      "defaultSize": { "width": 520, "height": 360 },
      "inputs": [
        { "kind": "text", "min": 1, "max": 1 }
      ],
      "output": { "kind": "text" },
      "timeoutSec": 60,
      "params": [
        { "key": "prefix", "label": "前缀", "type": "text", "default": "" }
      ]
    }
  ]
}
